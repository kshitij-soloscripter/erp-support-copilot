# Keep all settings optional. Defaults work locally after setup.
EMBEDDING_DIMENSIONS=512
DEVICE=auto
LLM_BASE_URL=http://127.0.0.1:8081
LLM_PORT=8081
APP_PORT=7860
LLM_CONTEXT_SIZE=4096
LLM_MAX_TOKENS=384
RETRIEVAL_K=16
RERANK_CANDIDATES=8
CONTEXT_CHUNKS=4
MIN_EXCERPT_SCORE=0.98
DOCUMENT_LIMIT=45
# Optional remote Qdrant server; unset uses persistent local storage.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
